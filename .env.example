# Public site URL used for confirmation links and Stripe return URLs.
NEXT_PUBLIC_SITE_URL=https://okcitycenterevents.org
SITE_URL=https://okcitycenterevents.org

# Development dashboard credentials.
DEVELOPMENT_ADMIN_USERNAME=
DEVELOPMENT_ADMIN_PASSWORD=
DEVELOPMENT_ADMIN_NEXT_PASSWORD=
DEVELOPMENT_ADMIN_PASSWORD_SWITCH_AT=

# Legacy Bowling admin secret and optional preview keys.
ADMIN_SECRET=
BOWLING_ADMIN_PREVIEW_KEY=
GALA_ADMIN_PREVIEW_KEY=

# Supabase persistence for Bowling registrations.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe checkout and webhook verification.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Confirmation email delivery (Resend).
# Create an API key at https://resend.com and verify the sending domain
# (okcitycenterevents.org). Without RESEND_API_KEY, confirmation emails are
# skipped and the confirmation page does not promise an email.
RESEND_API_KEY=
# Optional overrides (defaults shown):
# EMAIL_FROM=City Center Events <receipts@okcitycenterevents.org>
# EMAIL_REPLY_TO=kimberly@okcitycenter.org
